{
  "extends": "@react-native/typescript-config/tsconfig.json",
  "compilerOptions": {
    "baseUrl": ".",
    "paths": {
      "*": [
        "./src/*"
      ],
      "@Modules": [
        "src/Modules/index"
      ],
      "@Component/index": [
        "src/Component/index"
      ],
      "@Routes/*": [
        "src/Routes/*"
      ],
      "@assets/*": [
        "src/assets/*"
      ],
      "@utils/*": [
        "src/utils/*"
      ],
    },
  },
}